# ============================================================
# Forus 环境变量模板
# 复制为 .env 并填入真实值（.env 不会被提交到 Git）
# 部署到 Vercel 时，在 Project Settings → Environment Variables 配置下列变量
# ============================================================

# 自建 PostgREST 地址（nginx 会把 /db/rest/v1 剥成 PostgREST 根）
SUPABASE_URL=https://forus.los-theseus.site/db

# 浏览器可见的 forus_app JWT（由 PGRST_JWT_SECRET 签发）
SUPABASE_KEY=your-forus-app-jwt

# 服务端共用暗号（前端不可见，你和 TA 约定的口令）
NUXT_PASSPHRASE=your-passphrase

# Cookie 签名密钥（务必保密！生成命令见下方）
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_AUTH_SECRET=your-random-64-char-secret

# 服务端 forus_service JWT（仅服务端使用，绝不可暴露到前端）
# 用于信件 / 小猫对话等服务端接口
# 预构建产物在运行时也可用 NUXT_SUPABASE_SERVICE_ROLE_KEY 覆盖
SUPABASE_SERVICE_ROLE_KEY=your-forus-service-jwt

# 本地上传目录（迁移到自建存储后使用；容器内路径通常是 /data/uploads）
# 代码同时兼容服务器现有 compose 的单数写法 NUXT_UPLOAD_DIR
# NUXT_UPLOADS_DIR=/data/uploads

# 服务端访问 PostgREST 的 Docker 内网地址（可选；例如 http://forus-rest:3000）
# NUXT_SUPABASE_INTERNAL_URL=

# 尚锦 AI（OpenAI 兼容接口，服务端私有）
NUXT_CAT_API_BASE=https://wawapii.com/v1
NUXT_CAT_API_KEY=sk-xxxxxxxx
NUXT_CAT_MODEL=deepseek-chat
